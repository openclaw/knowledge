{
  "name": "openclaw-plugin-knowledge",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run skills:sync && tsc -p tsconfig.json && openclaw plugins build",
    "validate": "openclaw plugins validate --json",
    "pack": "openclaw plugins pack --json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs",
    "skills:sync": "node scripts/sync-skill-references.mjs",
    "prepack": "npm run skills:sync"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "fixtures/sample-vault",
    "docs/FORMAT.md",
    "ontologies",
    "THIRD_PARTY_NOTICES.md",
    "docs/ONTOLOGY.md",
    "docs/REAL_VAULT.md",
    "docs/MODEL_API.md",
    "docs/LOCAL_HISTORY.md",
    "docs/RETRIEVAL.md",
    "docs/EVIDENCE.md",
    "skills",
    "docs/WORKFLOWS.md",
    "scripts/sync-skill-references.mjs",
    "docs/STRUCTURED_WRITES.md",
    "docs/CORRECTIONS.md",
    "docs/MARKDOWN_LINKS.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.9.5"
  },
  "dependencies": {
    "dompurify": "3.4.15",
    "marked": "18.0.13",
    "typebox": "1.3.17",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "openclaw": "2026.9.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "@types/node": "26.5.1"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./src/control-ui.ts",
    "compat": {
      "pluginApi": ">=2026.9.5"
    },
    "build": {
      "openclawVersion": "2026.9.5"
    }
  },
  "description": "Evidence-backed knowledge vault and native OpenClaw explorer",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/knowledge.git"
  },
  "license": "MIT"
}
