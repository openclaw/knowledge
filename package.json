{
  "name": "openclaw-plugin-knowledge",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && openclaw plugins build",
    "validate": "openclaw plugins validate --json",
    "pack": "openclaw plugins pack --json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "fixtures/sample-vault",
    "docs/FORMAT.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.9.5"
  },
  "dependencies": {
    "typebox": "1.3.17",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "openclaw": "2026.9.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "@types/node": "26.5.1"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./src/control-ui.ts",
    "compat": {
      "pluginApi": ">=2026.9.5"
    },
    "build": {
      "openclawVersion": "2026.9.5"
    }
  },
  "description": "Evidence-backed knowledge vault and native OpenClaw explorer",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/knowledge.git"
  },
  "license": "MIT"
}
