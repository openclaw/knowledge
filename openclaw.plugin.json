{
  "id": "knowledge",
  "name": "Knowledge",
  "description": "Evidence-backed knowledge, inspectable in OpenClaw.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "vault": {
        "type": "object",
        "required": [
          "root",
          "statePath",
          "agentId",
          "vaultId",
          "publicationId",
          "operatorRead"
        ],
        "properties": {
          "root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "statePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "agentId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "vaultId": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "publicationId": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "operatorRead": {
            "type": "boolean"
          },
          "writesEnabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "controlUi": {
    "entry": "dist/control-ui/1ed960edc2c6d42b1c51f30963bd1f778be3ef87fb1846529f3f27c35b5d06e9/index.js",
    "styles": [
      "dist/control-ui/1ed960edc2c6d42b1c51f30963bd1f778be3ef87fb1846529f3f27c35b5d06e9/index.css"
    ]
  },
  "skills": [
    "./skills"
  ],
  "contracts": {
    "tools": [
      "knowledge_attach",
      "knowledge_attachment",
      "knowledge_connections",
      "knowledge_correct",
      "knowledge_create_claim",
      "knowledge_create_relationship",
      "knowledge_diagnostics",
      "knowledge_grep",
      "knowledge_history",
      "knowledge_lookup",
      "knowledge_mutation",
      "knowledge_ontology",
      "knowledge_record",
      "knowledge_records",
      "knowledge_resume",
      "knowledge_revision",
      "knowledge_save_page",
      "knowledge_status",
      "knowledge_withdraw"
    ]
  }
}
